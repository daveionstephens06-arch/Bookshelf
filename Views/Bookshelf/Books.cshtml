@model List<Book>

<h1>My shelf</h1>

@if (Model.Count == 0)
{
    <p>Your shelf is empty.</p>
}
else
{
    int read_count = 0;
    foreach (Book each_book in Model)
    {
        if (each_book.IsRead) { read_count++; }
        <partial name="_BookCard" model="each_book" />
    }
    <p>@read_count of @Model.Count read</p>
}